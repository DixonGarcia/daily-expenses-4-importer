# Daily Expenses 4 Importer Configuration Template
# Copy this file to data/config.toml and adjust your settings.

# Supported expense categories in your Daily Expenses 4 account
categories = [
  "Bills",
  "Clothing",
  "Dining",
  "Education",
  "Entertainment",
  "Fuel",
  "Groceries",
  "Healthcare",
  "Home",
  "Income",
  "Insurance",
  "Kids",
  "Merchandise",
  "Other",
  "Personal",
  "Pets",
  "Subscriptions",
  "Tips",
  "Toll",
  "Transfer",
  "Transportation",
  "Travel",
  "Utilities",
  "Vehicle"
]

# Account Profiles
# Define each account you want to import transactions into.

[accounts.default]
name = "Checking Account"
currency = "USD"
parser = "generic_csv"
decimal_mode = "exact" # "exact" (keeps cents) or "round_half_up"

[accounts.credit_card]
name = "Credit Card"
currency = "USD"
parser = "generic_excel"
source_transfer_account = "Checking Account"
decimal_mode = "exact"
